# Veridoc AI service configuration (all optional; sensible defaults shown).
# Copy to `.env` for local overrides. Never commit a real `.env`.

# Inference provider. Phase 1 supports "mock" only.
AI_PROVIDER=mock

# Logical model identifier reported in responses/health.
AI_MODEL_NAME=veridoc-mock-0.1

# Per-token streaming delay in seconds (demo pacing only; does not affect content).
AI_STREAM_TOKEN_DELAY_S=0.02

# CORS origins. Leave empty: this service is internal-only and is reached
# server-to-server by the gateway, never directly by a browser.
# AI_CORS_ALLOW_ORIGINS=[]

# --- Phase 2: database (PostgreSQL + pgvector) ---
AI_DATABASE_URL=postgresql://veridoc:veridoc@localhost:5432/veridoc

# --- Phase 2: embeddings ---
# "deterministic" (default, no heavy deps) or "sentence-transformers" (needs the
# optional [embeddings] extra: torch + sentence-transformers).
AI_EMBEDDING_PROVIDER=deterministic
AI_EMBEDDING_DIM=384
# AI_SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Phase 2: ingestion limits ---
AI_MAX_UPLOAD_BYTES=26214400
AI_MAX_PAGES=300
AI_PDF_PARSE_TIMEOUT_S=30
AI_CHUNK_SIZE_CHARS=800
AI_CHUNK_OVERLAP_CHARS=150
