# Veridoc AI service configuration (all optional; sensible defaults shown).
# Copy to `.env` for local overrides. Never commit a real `.env`.

# Inference provider: "mock" (default) or "openai_compatible" (local OpenAI-
# compatible server incl. vLLM). The mock never falls back to/from real inference.
AI_INFERENCE_PROVIDER=mock

# Logical model identifier reported by the mock provider.
AI_MODEL_NAME=veridoc-mock-0.1

# --- Phase 3: real inference (only used when AI_INFERENCE_PROVIDER=openai_compatible) ---
# AI_INFERENCE_BASE_URL=http://localhost:8001/v1
# AI_INFERENCE_MODEL=local-model
# AI_INFERENCE_API_KEY=            # optional; never logged
AI_INFERENCE_TIMEOUT_S=60
AI_INFERENCE_MAX_TOKENS=512
AI_INFERENCE_TEMPERATURE=0.0

# --- Phase 3: reranking ---
# "none" (default), "deterministic" (reproducible, no deps), or "cross-encoder".
AI_RERANKER_PROVIDER=none
# AI_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AI_RERANK_CANDIDATE_K=20

# Per-token streaming delay in seconds (demo pacing only; does not affect content).
AI_STREAM_TOKEN_DELAY_S=0.02

# CORS origins. Leave empty: this service is internal-only and is reached
# server-to-server by the gateway, never directly by a browser.
# AI_CORS_ALLOW_ORIGINS=[]

# --- Phase 2: database (PostgreSQL + pgvector) ---
AI_DATABASE_URL=postgresql://veridoc:veridoc@localhost:5432/veridoc

# --- Phase 2: embeddings ---
# "deterministic" (default, no heavy deps) or "sentence-transformers" (needs the
# optional [embeddings] extra: torch + sentence-transformers).
AI_EMBEDDING_PROVIDER=deterministic
AI_EMBEDDING_DIM=384
# AI_SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Phase 2: ingestion limits ---
AI_MAX_UPLOAD_BYTES=26214400
AI_MAX_PAGES=300
# Cap on cumulative extracted text; bounds a PDF "decompression bomb" whose
# content streams expand to huge text despite small byte/page counts.
AI_MAX_EXTRACTED_CHARS=20000000
AI_PDF_PARSE_TIMEOUT_S=30
AI_CHUNK_SIZE_CHARS=800
AI_CHUNK_OVERLAP_CHARS=150
# Max PDF ingestions processed at once; excess uploads get 429 (not queued).
AI_MAX_CONCURRENT_INGESTIONS=2

# --- Phase 3: generation safety ---
# Defensive cap on a buffered RAG answer (chars) before tokenizing/streaming.
AI_MAX_ANSWER_CHARS=24000
