# Veridoc API gateway configuration. Copy to `.env` for local overrides.
# Never commit a real `.env`.

# Port the gateway listens on.
PORT=3000

# Internal AI service base URL (server-to-server only; never exposed publicly).
AI_SERVICE_URL=http://127.0.0.1:8000

# Browser origin allowed by CORS (the Vite dev server by default).
WEB_ORIGIN=http://localhost:5173

# Upstream timeout (ms) when contacting the AI service.
AI_REQUEST_TIMEOUT_MS=30000

# Short timeout (ms) for the gateway's /ready probe of the AI service.
AI_HEALTH_TIMEOUT_MS=2000

NODE_ENV=development
